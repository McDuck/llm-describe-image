# Shared GPU API configuration
# Copy to .env and replace the token. The worker and Windows launcher load it automatically.

# Required bearer token for every /v1 request.
GPU_API_TOKEN=replace-with-a-long-random-secret

# Loopback-only listener settings. Keep these private; publish the service with
# a reverse SSH tunnel when the pipeline runs on another host.
GPU_API_HOST=127.0.0.1
GPU_API_PORT=5002

# Recognition service settings.
RECOGNITION_MODEL=buffalo_l
# Use DmlExecutionProvider for the Windows launcher, CUDAExecutionProvider for
# a compatible NVIDIA deployment, or CPUExecutionProvider for CPU-only use.
RECOGNITION_PROVIDER=DmlExecutionProvider

# Maximum binary upload accepted by POST /v1/video-frames (8 GiB by default).
VIDEO_FRAME_API_MAX_UPLOAD_BYTES=8589934592
