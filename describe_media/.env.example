# LLM Describe Image - Environment Configuration
# Copy this file to .env and customize the values

# Input/Output Directories
INPUT_DIR=
OUTPUT_DIR=

# Model Configuration
# Defaults target a local OpenAI-compatible server (for example, KoboldCpp).
MODEL_NAME=qwen/qwen3-vl-8b
BACKEND=openai
# Local servers commonly do not require authentication.
OPENAI_API_KEY=
# The default endpoint is the loopback-only KoboldCpp tunnel described in the README.
# Change this to https://api.openai.com/v1 and set OPENAI_API_KEY to use OpenAI instead.
OPENAI_API_BASE=http://127.0.0.1:15002/v1

# Prompt (can also use @file.txt to read from file)
# Template placeholders: {datetime}, {location}, {camera}, {focal_length}, {aperture}, {iso}, {shutter_speed}, {filename}
# Empty placeholders will be replaced with empty strings
PROMPT="Beschrijf de foto in het Nederlands"

# Thread Configuration
NUM_DISCOVER_THREADS=1
NUM_SKIP_CHECKER_THREADS=100
NUM_DOWNLOAD_THREADS=2
NUM_LLM_THREADS=1
NUM_WRITE_THREADS=1

# Backpressure Control
BACKPRESSURE_MULTIPLIER=2.0

# Sorting (natural-desc, natural-asc, name-desc, name-asc)
SORT_ORDER=natural-desc

# Retry Configuration
# Set to true to retry previously failed items (default: false)
RETRY_FAILED=false

# Optional remote video audio context. Each sampled frame receives the transcript
# of its non-overlapping surrounding audio interval. The selected transcription
# backend runs on the shared GPU worker.
VIDEO_TRANSCRIPTION_ENABLED=true
VIDEO_TRANSCRIPTION_BACKEND=faster-whisper
VIDEO_TRANSCRIPTION_MODEL=turbo
# VIDEO_TRANSCRIPTION_LANGUAGE=nl
# Optional separate text model/prompt for the synthesized source-video caption.
VIDEO_DESCRIPTION_MODEL=qwen/qwen3-vl-8b
VIDEO_DESCRIPTION_PROMPT="Beschrijf de volledige video in het Nederlands."

# Optional external Nominatim reverse geocoding for GPS-tagged photos.
REVERSE_GEOCODE_GPS=false
# Per-request timeout for reverse geocoding. Keep this comfortably above the
# geocoder's default short timeout, especially for WAN/storage deployments.
GEOLOCATE_TIMEOUT_S=30

# Local person-recognition workflow (install with: pip install -e .[recognition])
RECOGNITION_ENABLED=true
RECOGNITION_MODEL=buffalo_l
RECOGNITION_DETECTION_THRESHOLD=0.60
RECOGNITION_CLUSTER_THRESHOLD=0.45
RECOGNITION_MATCH_THRESHOLD=0.55
RECOGNITION_COPY_MATCHES_TO_REVIEW_CLUSTERS=true
# Shared GPU API for remote recognition, video-frame extraction, and Faster-
# Whisper inference. Required when VIDEO_TRANSCRIPTION_ENABLED=true.
# GPU_API_BASE=http://127.0.0.1:15003/v1
# GPU_API_TOKEN=replace-with-a-long-random-secret
# GPU_API_TIMEOUT_S=120

# Output Format
# Available placeholders: {datetime}, {location}, {content}, {filename}
# {content} is the LLM's response
# Use \n for newlines (will be interpreted by Python)
OUTPUT_FORMAT="Date time: {datetime}\nLocation: {location}\nDescription:\n{content}"

# Alternative format examples:
# Compact: OUTPUT_FORMAT="{datetime} | {location} | {content}"
# Description only: OUTPUT_FORMAT={content}
# With filename: OUTPUT_FORMAT="File: {filename}\n{content}"
# Markdown: OUTPUT_FORMAT="## {filename}\n**Date:** {datetime}\n**Location:** {location}\n\n{content}"

# Pipeline Selection
# Which pipeline to run: "describe-image" or "enhance-by-context"
PIPELINE=describe-image

# Context Enhancement Pipeline Settings (for enhance-by-context pipeline)
# Model to use for context enhancement (can be same or different from main model)
CONTEXT_MODEL=qwen/qwen3-vl-8b
# Prompt for enhancement
CONTEXT_PROMPT="Verbeter de beschrijving van de foto aan de hand van de context."
# Days before/after to search for context images
CONTEXT_WINDOW_DAYS=10
# Maximum number of context items to include
MAX_CONTEXT_ITEMS=20
